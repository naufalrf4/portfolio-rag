# Environment Variables for rag-service

# Admin Service API — used for internal coordination and log shipping
ADMIN_API_URL=http://localhost:3001

# Service token for Admin internal API access and log ingest authentication
# Server-side only — never expose this under a PUBLIC_ prefix
ADMIN_INTERNAL_API_TOKEN=generate_with_openssl_rand_hex_32

# Token used for RAG-to-Admin public write calls
RAG_SERVICE_TOKEN=generate_with_openssl_rand_hex_32

# Protects the RAG ingest endpoint (falls back to ADMIN_SERVICE_TOKEN)
RAG_INGEST_SERVICE_TOKEN=generate_with_openssl_rand_hex_32

# Legacy fallback service token (prefer ADMIN_INTERNAL_API_TOKEN)
# ADMIN_SERVICE_TOKEN=legacy-fallback-only

# OpenAI API configuration for embeddings and chat
OPENAI_API_KEY=sk-...

# (Optional) Google Gemini API key for alternate LLM provider
# GEMINI_API_KEY=...

# Database connection
RAG_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio

# Port to run the service on
PORT=3005

# Browser origins allowed to call the service
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
